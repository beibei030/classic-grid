{
  "name": "classic-grid-master",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "经典网格：Decibel/N1/PopDEX/RISEx",
  "scripts": {
    "start": "node --import tsx src/cli/run.ts",
    "start:dec-pop": "node --import tsx src/cli/run-dec-pop.ts",
    "start:four": "node --import tsx src/cli/run-four.ts",
    "start:lit-prog": "node --import tsx src/cli/run-lit-prog.ts",
    "status": "node --import tsx src/cli/status.ts",
    "flat": "node --import tsx src/cli/flat.ts",
    "dashboard": "node --import tsx src/cli/dashboard.ts",
    "test": "node --import tsx test/grid.test.ts && node --import tsx test/hedge.test.ts",
    "test:hedge": "node --import tsx test/hedge.test.ts",
    "start:hedge": "node --import tsx src/cli/run-hedge.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.1",
    "@decibeltrade/sdk": "^0.6.0",
    "@ellipsis-labs/rise": "^0.4.67",
    "@n1xyz/nord-ts": "^0.6.3",
    "@solana/web3.js": "^1.98.4",
    "risex-client": "^0.1.11",
    "tsx": "^4.19.2",
    "undici": "^6.21.0",
    "viem": "^2.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
