# ============================================================
# 经典网格总控 · 环境模板
# 复制为 .env 后填真实密钥；.env 永不提交仓库
# 默认 dry-run；实盘须 LIVE_CONFIRM=YES 且 DRY_RUN=0
# 现档：Decibel / PopDEX 90 格、N1 100 格、RISEx 46 格
#       30x（RISEx 25x）、1000U × 60%（N1 保证金 45%）
#       前紧后松：中心 ±4%、外层 ±8%
# ============================================================

# ---- 全局 ----
DRY_RUN=1
LIVE_CONFIRM=
VENUES=decibel,n1,popdex,risex
MARKETS=BTC
TICK_MS=10000
GRID_LEVERAGE=30
GRID_MARGIN_FRAC=0.6
DASHBOARD_PORT=8088
GRID_SKIP_LEVERAGE=0
SOFT_RESUME=1

# ---- RISEx — https://www.rise.trade/invite/aiqiang ----
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=
RISEX_API_URL=https://api.rise.trade
RISEX_WS_URL=wss://ws.rise.trade/ws
RISE_ORDER_GAP_MS=10500
RISE_SKIP_LEVERAGE=0
RISEX_LEVERAGE=
RISEX_EQUITY_USD=
RISEX_MARGIN_FRAC=

# ---- Decibel — https://app.decibel.trade/ ----
DECIBEL_ACCOUNT_PRIVATE_KEY=
DECIBEL_API_KEY=
DECIBEL_SUBACCOUNT=
DECIBEL_GAS_STATION_API_KEY=
DECIBEL_LEVERAGE=
DECIBEL_EQUITY_USD=
DECIBEL_MARGIN_FRAC=

# ---- N1 — https://app.n1.xyz/（keypair 默认 secrets/id.json）----
N1_KEYPAIR_PATH=secrets/id.json
N1_APP_PUBLIC_KEY=
N1_API_URL=https://zo-mainnet.n1.xyz
N1_SOLANA_RPC=https://api.mainnet-beta.solana.com
N1_TRADING_ARMED=NO
N1_LEVERAGE=
N1_EQUITY_USD=
N1_MARGIN_FRAC=

# ---- 止损（start:lit-prog 默认开启；旧 npm start 不设则不影响）----
# STOP_LOSS=1
# STOP_LOSS_VENUES=decibel,n1,popdex,risex
# STOP_HARD_PCT=0.014
# STOP_LADDER_START=0
# STOP_LADDER_STEP=0.007
# STOP_LADDER_FRAC=0.25
# STOP_LADDER_COOLDOWN_MS=60000

# ---- PopDEX — https://app.popdex.xyz/（Morph Tachyon，secrets/popdex.key）----
POPDEX_PRIVATE_KEY=
POPDEX_KEY_PATH=secrets/popdex.key
POPDEX_ADDRESS=
POPDEX_SYMBOL=
POPDEX_EQUITY_USD=
POPDEX_LEVERAGE=
POPDEX_MARGIN_FRAC=
POPDEX_ORDER_GAP_MS=200

# ---- Telegram（可选）----
# 1) BotFather 建 bot → TELEGRAM_BOT_TOKEN
# 2) 给 bot 发消息后 getUpdates 取 chat.id → TELEGRAM_CHAT_IDS（逗号分隔）
# 3) TELEGRAM_ENABLED=true 后重启；开/平、错误、整点总览推送
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
