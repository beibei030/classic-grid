# 默认 dry-run；实盘须 LIVE_CONFIRM=YES 且 DRY_RUN=0
DRY_RUN=1
LIVE_CONFIRM=
VENUES=extended,risex,decibel,n1,phoenix
MARKETS=BTC
TICK_MS=15000
GRID_LEVERAGE=30
RISEX_LEVERAGE=25
GRID_MARGIN_FRAC=0.7
GRID_HALF_BAND=3000
RISEX_HALF_BAND=1950
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8088
GRID_SKIP_LEVERAGE=0
SOFT_RESUME=1

# 网格重心化默认关闭；先在 DRY_RUN 验证，再显式开启
GRID_RECENTER_ENABLED=0
GRID_RECENTER_RATIO=0.65
GRID_RECENTER_CONFIRM_TICKS=3
GRID_RECENTER_COOLDOWN_MS=600000
GRID_RECENTER_CANCEL_TIMEOUT_MS=900000
# 仅在 |position × mid| 不超过此值时允许重心化
GRID_RECENTER_MAX_POSITION_USD=1

# Extended — https://app.extended.exchange/
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_ID=
EXTENDED_VAULT=
EXTENDED_API_URL=https://api.starknet.extended.exchange
EXTENDED_USE_PROXY=0
EXTENDED_PROXY=

# RISEx — https://rise.trade/
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=
RISEX_API_URL=https://api.rise.trade
RISEX_WS_URL=wss://ws.rise.trade/ws
RISE_ORDER_GAP_MS=10500
RISE_SKIP_LEVERAGE=0

# Decibel — https://app.decibel.trade/
DECIBEL_ACCOUNT_PRIVATE_KEY=
DECIBEL_API_KEY=
DECIBEL_SUBACCOUNT=
DECIBEL_GAS_STATION_API_KEY=

# N1 — https://app.n1.xyz/（keypair 默认放 secrets/id.json，勿提交仓库）
N1_KEYPAIR_PATH=secrets/id.json
N1_APP_PUBLIC_KEY=
N1_API_URL=https://zo-mainnet.n1.xyz
N1_SOLANA_RPC=https://api.mainnet-beta.solana.com
N1_TRADING_ARMED=NO

# Phoenix — https://phoenix.trade/（Solana key；可用文件或环境变量）
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=secrets/phoenix.json
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Telegram（可选；token/chat_id 只放本机 .env，勿提交）
# 1) BotFather 建 bot → TELEGRAM_BOT_TOKEN
# 2) 给 bot 发消息后 getUpdates 取 chat.id → TELEGRAM_CHAT_IDS（多个逗号分隔）
# 3) TELEGRAM_ENABLED=true 后重启；开/平、错误、整点总览会推送
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
