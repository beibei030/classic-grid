# ============================================================
# 经典网格总控 · 环境模板
# 复制为 .env 后填真实密钥；.env 永不提交仓库
# 默认 dry-run；实盘须 LIVE_CONFIRM=YES 且 DRY_RUN=0
# ============================================================

# ---- 全局 ----
DRY_RUN=1
LIVE_CONFIRM=
VENUES=extended,risex,decibel,n1,phoenix,phoenix2,nado,popdex
# 三所独立实例（npm run start:three）默认：
# VENUES=decibel,n1,entropy
# STOP_LOSS=1
# STOP_LOSS_VENUES=decibel,n1,entropy
MARKETS=BTC
TICK_MS=15000
GRID_LEVERAGE=30
GRID_MARGIN_FRAC=0.7
GRID_HALF_BAND=3000
DASHBOARD_PORT=8088
GRID_SKIP_LEVERAGE=0
SOFT_RESUME=1

# ---- Extended — https://app.extended.exchange/ ----
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_ID=
EXTENDED_VAULT=
EXTENDED_API_URL=https://api.starknet.extended.exchange
EXTENDED_USE_PROXY=0
EXTENDED_PROXY=
EXTENDED_LEVERAGE=
EXTENDED_ORDER_GAP_MS=

# ---- RISEx — https://rise.trade/ ----
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=
RISEX_API_URL=https://api.rise.trade
RISEX_WS_URL=wss://ws.rise.trade/ws
RISE_ORDER_GAP_MS=10500
RISE_SKIP_LEVERAGE=0
RISEX_LEVERAGE=
RISEX_HALF_BAND=

# ---- Decibel — https://app.decibel.trade/ ----
DECIBEL_ACCOUNT_PRIVATE_KEY=
DECIBEL_API_KEY=
DECIBEL_SUBACCOUNT=
DECIBEL_GAS_STATION_API_KEY=
DECIBEL_LEVERAGE=
DECIBEL_EQUITY_USD=
DECIBEL_HALF_BAND=

# ---- N1 — https://app.n1.xyz/（keypair 默认 secrets/id.json）----
N1_KEYPAIR_PATH=secrets/id.json
N1_APP_PUBLIC_KEY=
N1_API_URL=https://zo-mainnet.n1.xyz
N1_SOLANA_RPC=https://api.mainnet-beta.solana.com
N1_TRADING_ARMED=NO
N1_LEVERAGE=
N1_EQUITY_USD=
N1_HALF_BAND=

# ---- Phoenix / Phoenix2 — https://phoenix.trade/（Solana keypair）----
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=secrets/phoenix.key
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_SOLANA_RPC=https://api.mainnet-beta.solana.com
PHOENIX_ORDER_GAP_MS=800
PHOENIX_CU_LIMIT=
PHOENIX_LEVERAGE=
PHOENIX_HALF_BAND=
PHOENIX2_PRIVATE_KEY=
PHOENIX2_KEYPAIR_PATH=secrets/phoenix2.key
PHOENIX2_API_URL=
PHOENIX2_SOLANA_RPC=
PHOENIX2_LEVERAGE=
PHOENIX2_HALF_BAND=

# ---- Nado — https://nado.xyz/（Ink 链，secrets/nado.key）----
NADO_PRIVATE_KEY=
NADO_KEY_PATH=secrets/nado.key
NADO_ADDRESS=
NADO_SUBACCOUNT=
NADO_BTC_PRODUCT_ID=
NADO_INK_RPC=
NADO_ORDER_GAP_MS=200
NADO_LEVERAGE=
NADO_HALF_BAND=

# ---- Entropy — https://entropy.io/?r=aiqiang（走 Hyperliquid API，须全仓）----
ENTROPY_PRIVATE_KEY=
ENTROPY_KEY_PATH=secrets/entropy.key
ENTROPY_LEVERAGE=30
ENTROPY_EQUITY_USD=800
ENTROPY_HALF_BAND=
ENTROPY_ORDER_GAP_MS=200

# ---- 止损（start:three 默认开启；旧 npm start 不设则不影响）----
# STOP_LOSS=1
# STOP_LOSS_VENUES=decibel,n1,entropy
# STOP_HARD_PCT=0.025
# STOP_LADDER_START=0.01
# STOP_LADDER_STEP=0.02
# STOP_LADDER_FRAC=0.15
# STOP_LADDER_COOLDOWN_MS=1800000
# STOP_REANCHOR_MS=10800000

# ---- PopDEX — https://app.popdex.xyz/（Morph Tachyon，secrets/popdex.key）----
POPDEX_PRIVATE_KEY=
POPDEX_KEY_PATH=secrets/popdex.key
POPDEX_ADDRESS=
POPDEX_SYMBOL=
POPDEX_EQUITY_USD=800
POPDEX_GRID_COUNT=80
POPDEX_LEVERAGE=30
POPDEX_HALF_BAND=
POPDEX_ORDER_GAP_MS=200

# ---- Pacifica — https://app.pacifica.fi/（Solana keypair，须全仓）----
# 独立启动：npm run start:pacifica
# 实盘另需 LIVE_CONFIRM=YES、DRY_RUN=0、PACIFICA_TRADING_ARMED=YES
PACIFICA_PRIVATE_KEY=
PACIFICA_KEY_PATH=secrets/pacifica.key
PACIFICA_API_URL=https://api.pacifica.fi/api/v1
PACIFICA_TRADING_ARMED=NO
PACIFICA_LEVERAGE=30
PACIFICA_EQUITY_USD=1000
PACIFICA_MARGIN_FRAC=0.6
PACIFICA_HALF_BAND=
PACIFICA_ORDER_GAP_MS=200

# ---- Lighter RH — https://robinhoodchain.lighter.xyz/（Python lighter-sdk）----
# 钥匙：secrets/lighter.key（account_index / api_key_index / private_key）
# 实盘另需 LIVE_CONFIRM=YES、DRY_RUN=0、LIGHTER_TRADING_ARMED=YES
LIGHTER_KEY_PATH=secrets/lighter.key
LIGHTER_API_URL=https://api.rh.lighter.xyz
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_TRADING_ARMED=NO
LIGHTER_LEVERAGE=30
LIGHTER_EQUITY_USD=1000
LIGHTER_MARGIN_FRAC=0.6
LIGHTER_HALF_BAND=
LIGHTER_PYTHON=python

# ---- Telegram（可选）----
# 1) BotFather 建 bot → TELEGRAM_BOT_TOKEN
# 2) 给 bot 发消息后 getUpdates 取 chat.id → TELEGRAM_CHAT_IDS（逗号分隔）
# 3) TELEGRAM_ENABLED=true 后重启；开/平、错误、整点总览推送
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
